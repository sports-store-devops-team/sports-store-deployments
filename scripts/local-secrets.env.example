# The setup script normally creates local-secrets.env automatically; users do
# not need to copy or edit this example. This file documents the required shape.
# For manual development values, use URL-safe generators such as:
#   openssl rand -hex 24   # MongoDB password
#   openssl rand -hex 32   # JWT secret

MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=
JWT_SECRET=
